{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eatco",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Worker 를 D1 옆(싱가포르)에서 돌린다.
  //
  // 기본값은 사용자 근처 엣지 실행인데, D1 주 인스턴스가 SIN 이라 요청마다
  // 한국↔싱가포르를 왕복한다. 실측: SELECT 1 짜리 /api/health 가 522ms,
  // D1 을 2번 부르는 /api/calendar 가 694ms. 쿼리 자체는 0.17ms 다.
  //
  // 예전에 이 설정을 켰다가 껐던 이유는 Gemini 지역차단이 악화돼서였는데,
  // 지금은 Gemini 를 브라우저에서 직접 부르므로 해당되지 않는다.
  "placement": { "mode": "smart" },

  "vars": {
    // Cloudflare Access 는 쓰지 않는다. 앱은 자체 세션 쿠키로 인증한다.
    //
    // 예전에는 ACCESS_TEAM_DOMAIN 만 넣고 ACCESS_AUD 는 비워뒀는데,
    // verifyAccessJwt 가 aud 를 조건부로만 검사해서 **그 Zero Trust 조직의
    // 어떤 애플리케이션에서 발급된 토큰이든** 통과했다. 그러면
    // resolveUser 가 그 토큰의 이메일로 계정을 자동 생성한다.
    // JWKS 엔드포인트가 살아 있어서 (200) 조직 자체는 실재한다.
    //
    // Access 를 실제로 붙일 때는 **두 개를 같이** 넣는다:
    //   "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    //   "ACCESS_AUD": "<Access 애플리케이션의 Application Audience Tag>"
    // 하나만 넣으면 requireUser 가 500 으로 막는다 (identity.ts 참조).
  },

  // 예전에는 이 파일이 없어서 wrangler 가 frontend/ 를 "정적 사이트"로 오인하고
  // .tsx 원본 60개를 그대로 업로드했다. 빌드 산출물을 명시한다.
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /api/* 는 자산보다 Worker 가 먼저 처리한다. 나머지는 자산 우선 + SPA 폴백.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "eatco", "database_id": "3b40ea8f-e4fd-41d3-9b97-6ce05a27944f" }
  ],

  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "eatco-uploads" }
  ],

  // 소비기한 알림. 예전 APScheduler 는 15분 간격 인메모리라 배포/재시작 때
  // 그 창의 알림이 조용히 유실됐다. 매시 정각 + DB 기준 윈도우로 바꾸면
  // 한 번 걸러도 다음 실행이 따라잡는다 (expiry 알림은 이미 멱등).
  "triggers": { "crons": ["0 * * * *"] }
}
